{
  "name": "binzip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "pnu": "tsx scripts/pnu-cli.ts",
    "ledger:inspect": "tsx scripts/build-ledger.ts --inspect",
    "ledger:build": "tsx scripts/build-ledger.ts",
    "verify:g1": "tsx --env-file=.env scripts/verify-g1.ts",
    "verify:address": "tsx --env-file=.env scripts/verify-address.ts",
    "verify:transaction": "tsx --env-file=.env scripts/verify-transaction.ts",
    "collect:addresses": "tsx --env-file=.env scripts/collect-addresses.ts",
    "diagnose": "tsx --env-file=.env scripts/diagnose.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^4.5.3",
    "iconv-lite": "^0.6.3",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
