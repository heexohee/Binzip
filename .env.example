# ── 0단계: 주소 → PNU ────────────────────────────────────────
# 창구 선택: juso (기본, 권장) | kakao
ADDRESS_PROVIDER=juso

# 행정안전부 도로명주소 API 승인키
# https://business.juso.go.kr  →  OPEN API → 도로명주소조회 → 신청 (개발용은 즉시 발급)
JUSO_CONFM_KEY=

# 카카오 REST 키 (예비 창구). 쓰려면 앱에서 '카카오맵' 제품 활성화가 필요하다.
KAKAO_REST_KEY=

# ── VWorld (2·3·4·5단계) ─────────────────────────────────────
# https://www.vworld.kr  →  오픈API → 인증키 발급
# 발급 시 등록한 서비스 URL 을 VWORLD_DOMAIN 에 그대로 적는다.
# 로컬 개발용으로 http://localhost:3000 도 함께 등록해 둘 것.
VWORLD_KEY=
VWORLD_DOMAIN=http://localhost:3000

# ── 공공데이터포털 (선택: 실거래가, 또는 개별주택가격 대체 경로) ──
# https://www.data.go.kr
# ⚠️ 반드시 '디코딩(Decoding)' 키를 넣을 것. 인코딩 키는 이중 인코딩으로 실패한다.
DATA_GO_KR_KEY=

# ── 소스 선택 / 엔드포인트 덮어쓰기 ───────────────────────────
# 개별주택가격을 어느 창구로 받을지: vworld (기본) | datagokr
HOUSE_PRICE_PROVIDER=vworld
# 활용가이드로 확정한 실제 경로가 다르면 아래에 적는다
# HOUSE_PRICE_ENDPOINT=
# LAND_USE_ENDPOINT=
